---
// 全局样式只在这里引入一次，所有页面通过 BaseHead 共享
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

interface Props {
	title: string;
	description?: string;
	image?: string;
}

// Astro 6 起，build.format:'file' 时 pathname 会带上 index.html，
// 这里去掉，避免 canonical 指向 /index.html 造成重复 URL
const pathname = Astro.url.pathname.replace(/index\.html$/, '');
const canonicalURL = new URL(pathname, Astro.site);
const {
	title,
	description = SITE_DESCRIPTION,
	image = '/img/banner-dusk.jpg',
} = Astro.props;
const ogImage = new URL(image, Astro.site ?? Astro.url);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" sizes="128x128" href="/img/favicon.png" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site ?? Astro.url)}
/>
<meta name="generator" content={Astro.generator} />

<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />

<meta name="twitter:card" content="summary_large_image" />
